{
  "name": "gitvur-app",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check:contrast": "node scripts/check-contrast.ts",
    "e2e": "node scripts/gen-synthetic.ts --quiet && playwright test",
    "e2e:perf": "node scripts/gen-synthetic.ts --quiet && GITVUR_PERF=1 playwright test -g budgets --project light --workers 1",
    "gen:synthetic": "node scripts/gen-synthetic.ts",
    "gen:types": "cd .. && GITVUR_WRITE_BINDINGS=1 cargo test -q -p gitvur-app --lib bindings",
    "tauri": "tauri"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@xyflow/react": "12.12.0",
    "decode-named-character-reference": "^1.3.0",
    "github-slugger": "^2.0.0",
    "mermaid": "^12.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shiki": "4.5.0",
    "unified": "^11.0.5",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}

    {
      "author": "Ada Example",
      "date": 1793178000,
      "sha": "2aebfaefbac002f93e0200dab89f2e07bc71e647",
      "short": "2aebfae",
      "subject": "Price formatting lives with the models"
    }
  ],
  "fromSources": {
    "shop/models.py": "\"\"\"Catalogue models.\"\"\"\n\n\nclass Book:\n    def __init__(self, name, price):\n        self.name = name\n        self.price = price\n\n    def describe(self):\n        return \"Book: \" + self.name\n\n\nclass Toy:\n    def __init__(self, name, price):\n        self.name = name\n        self.price = price\n\n    def describe(self):\n        return \"Toy: \" + self.name.upper()\n\n\ndef format_price(amount, currency=\"EUR\"):\n    def with_symbol(text):\n        symbol = SYMBOLS.get(currency, currency)\n        return symbol + \" \" + text\n\n    return with_symbol(\"%.2f\" % amount)\n",
    "shop/orders.py": "\"\"\"Order handling: pricing, persistence and receipts.\"\"\"\n\nfrom shop.cache import Cache\nfrom shop.models import format_price as fmt\n\nfrom .store import Store\n\n\nclass OrderService:\n    def __init__(self, path):\n        self.store = Store(path)\n        self.cache = Cache()\n\n    def place(self, item):\n        self.remember(item)\n        return self.receipt(item)\n\n    def remember(self, item):\n        backend = self.cache if item.price < 10 else self.store\n        backend.save(item)\n\n    def receipt(self, item):\n        slug = item.name.lower()\n        price = fmt(item.price)\n        return slug + \" - \" + price\n",
    "shop/utils.py": "\"\"\"Formatting helpers shared across the shop package.\"\"\"\n\nSYMBOLS = {\"EUR\": \"EUR\", \"USD\": \"$\"}\n\n\ndef cents(value):\n    return int(round(value * 100))\n\n\ndef to_amount(value):\n    return float(value)\n\n\n# Rounded variant. This definition shadows the one above at import time.\ndef to_amount(value):\n    return round(float(value), 2)\n"
  }
}
